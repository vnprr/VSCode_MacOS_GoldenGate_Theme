  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#6E6E73",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#A23B4A"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#5A5A5F"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#6947A0"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.class",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#0A7184"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#29723B"
      }
    },
    {
      "name": "Numbers, constants, and language values",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.language"
      ],
      "settings": {
        "foreground": "#A25121"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#2C2C2E"
      }
    },
    {
      "name": "Properties and object keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#116AAB"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#AD493A"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.tag.attributes"
      ],
      "settings": {
        "foreground": "#75569E"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "source.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#856000"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#0A7184",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Imports and namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "meta.module-reference",
        "support.module"
      ],
      "settings": {
        "foreground": "#0A7184"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#75569E"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "string.json support.type.property-name"
      ],
      "settings": {
        "foreground": "#116AAB"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#AD493A"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#116AAB"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#6947A0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#1D1D1F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#1D1D1F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#29723B"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#116AAB",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#6E6E73",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#1F7A34"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#D70015"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#A64B00"
      }
    },
    {
      "name": "Invalid and deprecated",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#C1252D",
        "fontStyle": "italic underline"
      }
    },
    {
      "name": "Diagnostic info",
      "scope": [
        "token.info-token"
      ],
      "settings": {
        "foreground": "#0066CC"
      }
    },
    {
      "name": "Diagnostic warning",
      "scope": [
        "token.warn-token"
      ],
      "settings": {
        "foreground": "#A64B00"
      }
    },
    {
      "name": "Diagnostic error",
      "scope": [
        "token.error-token"
      ],
      "settings": {
        "foreground": "#D70015"
      }
    },
    {
      "name": "Diagnostic debug",
      "scope": [
        "token.debug-token"
      ],
      "settings": {
        "foreground": "#7D3C98"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#0A7184",
    "type": "#0A7184",
    "class": "#0A7184",
    "enum": "#0A7184",
    "interface": "#0A7184",
    "struct": "#0A7184",
    "typeParameter": "#00788F",
    "parameter": "#2C2C2E",
    "variable": "#2C2C2E",
    "property": "#116AAB",
    "enumMember": "#A25121",
    "event": "#A83B68",
    "function": "#6947A0",
    "method": "#6947A0",
    "macro": "#A25121",
    "label": "#5A5A5F",
    "comment": {
      "foreground": "#6E6E73",
      "italic": true
    },
    "string": "#29723B",
    "number": "#A25121",
    "regexp": "#856000",
    "operator": "#5A5A5F",
    "keyword": "#A23B4A",
    "decorator": "#75569E",
    "*.declaration": {
      "bold": false
    },
    "variable.readonly": {
      "foreground": "#A25121"
    },
    "property.readonly": {
      "foreground": "#0A7184"
    },
    "method.declaration": {
      "bold": false
    },
    "function.declaration": {
      "bold": false
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
