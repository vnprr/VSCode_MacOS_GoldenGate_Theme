  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#746B64",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#A23B4A"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#76563E"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#6947A0"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.class",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#0A7184"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#29723B"
      }
    },
    {
      "name": "Numbers, constants, and language values",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.language"
      ],
      "settings": {
        "foreground": "#A25121"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#322D2A"
      }
    },
    {
      "name": "Properties and object keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#116AAB"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#AD493A"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.tag.attributes"
      ],
      "settings": {
        "foreground": "#75569E"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "source.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#856000"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#0A7184",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Imports and namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "meta.module-reference",
        "support.module"
      ],
      "settings": {
        "foreground": "#0A7184"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#75569E"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "string.json support.type.property-name"
      ],
      "settings": {
        "foreground": "#116AAB"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#AD493A"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#116AAB"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#6947A0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#1A1715",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#1A1715",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#29723B"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#116AAB",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#746B64",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#237A3B"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#C12D34"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#B84D0A"
      }
    },
    {
      "name": "Invalid and deprecated",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#C1252D",
        "fontStyle": "italic underline"
      }
    },
    {
      "name": "Diagnostic info",
      "scope": [
        "token.info-token"
      ],
      "settings": {
        "foreground": "#006BC7"
      }
    },
    {
      "name": "Diagnostic warning",
      "scope": [
        "token.warn-token"
      ],
      "settings": {
        "foreground": "#B84D0A"
      }
    },
    {
      "name": "Diagnostic error",
      "scope": [
        "token.error-token"
      ],
      "settings": {
        "foreground": "#C12D34"
      }
    },
    {
      "name": "Diagnostic debug",
      "scope": [
        "token.debug-token"
      ],
      "settings": {
        "foreground": "#8C35A0"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#0A7184",
    "type": "#0A7184",
    "class": "#0A7184",
    "enum": "#0A7184",
    "interface": "#0A7184",
    "struct": "#0A7184",
    "typeParameter": "#00788F",
    "parameter": "#322D2A",
    "variable": "#322D2A",
    "property": "#116AAB",
    "enumMember": "#A25121",
    "event": "#A83B68",
    "function": "#6947A0",
    "method": "#6947A0",
    "macro": "#A25121",
    "label": "#76563E",
    "comment": {
      "foreground": "#746B64",
      "italic": true
    },
    "string": "#29723B",
    "number": "#A25121",
    "regexp": "#856000",
    "operator": "#76563E",
    "keyword": "#A23B4A",
    "decorator": "#75569E",
    "*.declaration": {
      "bold": false
    },
    "variable.readonly": {
      "foreground": "#A25121"
    },
    "property.readonly": {
      "foreground": "#0A7184"
    },
    "method.declaration": {
      "bold": false
    },
    "function.declaration": {
      "bold": false
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
