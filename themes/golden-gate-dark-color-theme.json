  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#9B9189",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#FF8A8F"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#D8B193"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#D2ABFF"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.class",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#6CD7E8"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#82D897"
      }
    },
    {
      "name": "Numbers, constants, and language values",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.language"
      ],
      "settings": {
        "foreground": "#FFB272"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#EDE4DC"
      }
    },
    {
      "name": "Properties and object keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#74BCFF"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#FF9188"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.tag.attributes"
      ],
      "settings": {
        "foreground": "#C6A7FF"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "source.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#F0D06F"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#6CD7E8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Imports and namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "meta.module-reference",
        "support.module"
      ],
      "settings": {
        "foreground": "#6CD7E8"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#C6A7FF"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "string.json support.type.property-name"
      ],
      "settings": {
        "foreground": "#74BCFF"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#FF9188"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#74BCFF"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#D2ABFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F5F0EA",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#F5F0EA",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#82D897"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "#74BCFF",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#9B9189",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#72D38A"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#FF777B"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#FFAA66"
      }
    },
    {
      "name": "Invalid and deprecated",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#FF6B6F",
        "fontStyle": "italic underline"
      }
    },
    {
      "name": "Diagnostic info",
      "scope": [
        "token.info-token"
      ],
      "settings": {
        "foreground": "#62B8FF"
      }
    },
    {
      "name": "Diagnostic warning",
      "scope": [
        "token.warn-token"
      ],
      "settings": {
        "foreground": "#FFAA66"
      }
    },
    {
      "name": "Diagnostic error",
      "scope": [
        "token.error-token"
      ],
      "settings": {
        "foreground": "#FF777B"
      }
    },
    {
      "name": "Diagnostic debug",
      "scope": [
        "token.debug-token"
      ],
      "settings": {
        "foreground": "#D999E5"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#6CD7E8",
    "type": "#6CD7E8",
    "class": "#6CD7E8",
    "enum": "#6CD7E8",
    "interface": "#6CD7E8",
    "struct": "#6CD7E8",
    "typeParameter": "#69D9F3",
    "parameter": "#EDE4DC",
    "variable": "#EDE4DC",
    "property": "#74BCFF",
    "enumMember": "#FFB272",
    "event": "#F08AB1",
    "function": "#D2ABFF",
    "method": "#D2ABFF",
    "macro": "#FFB272",
    "label": "#D8B193",
    "comment": {
      "foreground": "#9B9189",
      "italic": true
    },
    "string": "#82D897",
    "number": "#FFB272",
    "regexp": "#F0D06F",
    "operator": "#D8B193",
    "keyword": "#FF8A8F",
    "decorator": "#C6A7FF",
    "*.declaration": {
      "bold": false
    },
    "variable.readonly": {
      "foreground": "#FFB272"
    },
    "property.readonly": {
      "foreground": "#6CD7E8"
    },
    "method.declaration": {
      "bold": false
    },
    "function.declaration": {
      "bold": false
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
