{
  "workbench.preferredLightColorTheme": "macOS Golden Gate — Light",
  "workbench.preferredDarkColorTheme": "macOS Golden Gate — Dark",
  "window.autoDetectColorScheme": true,
  "workbench.iconTheme": "macos-golden-gate-files",
  "workbench.productIconTheme": "macos-golden-gate-symbols",
  "workbench.experimental.modernUI": true,
  "workbench.shadows": true,
  "workbench.reduceTransparency": "on",
  "workbench.activityBar.location": "top",
  "workbench.activityBar.autoHide": false,
  "workbench.activityBar.compact": false,
  "workbench.sideBar.location": "left",
  "workbench.navigationControl.enabled": true,
  "workbench.layoutControl.enabled": true,
  "workbench.layoutControl.type": "both",
  "window.commandCenter": true,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabActionLocation": "left",
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.pinnedTabSizing": "compact",
  "workbench.editor.titleScrollbarVisibility": "auto",
  "window.density.editorTabHeight": "default",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.wrapTabs": false,
  "workbench.tree.indent": 12,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.enableStickyScroll": true,
  "workbench.list.smoothScrolling": true,
  "workbench.fontAliasing": "antialiased",
  "explorer.compactFolders": false,
  "explorer.decorations.colors": true,
  "editor.fontFamily": "'SF Mono', 'SFMono-Regular', '.SF NS Mono', ui-monospace, Menlo, Monaco, monospace",
  "editor.fontSize": 13,
  "editor.fontWeight": "400",
  "editor.lineHeight": 20,
  "editor.letterSpacing": 0,
  "editor.fontLigatures": false,
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.padding.top": 8,
  "editor.padding.bottom": 8,
  "editor.minimap.enabled": false,
  "editor.scrollbar.vertical": "auto",
  "editor.scrollbar.horizontal": "auto",
  "editor.scrollbar.verticalScrollbarSize": 10,
  "editor.scrollbar.horizontalScrollbarSize": 10,
  "terminal.integrated.fontFamily": "'SF Mono', 'SFMono-Regular', '.SF NS Mono', ui-monospace, Menlo, Monaco, monospace",
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.lineHeight": 1.25,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "breadcrumbs.enabled": true,
  "workbench.statusBar.visible": false,
  "workbench.tips.enabled": false
}
